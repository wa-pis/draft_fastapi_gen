SERVICE_NAME=calculation-worker
LOG_LEVEL=INFO

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=INTEGRATIONS
KAFKA_GROUP_ID=calculation-worker-v1
KAFKA_CLIENT_ID=calculation-worker-local
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_DELIVERY_TIMEOUT_MS=30000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_POLL_TIMEOUT_SECONDS=1.0
KAFKA_PUBLISH_TIMEOUT_SECONDS=35.0
KAFKA_SHUTDOWN_FLUSH_TIMEOUT_SECONDS=5.0

# Leave the optional SASL/SSL values empty when using PLAINTEXT.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

# PostgreSQL system database used by DBOS. Run migrations before either process.
DBOS_SYSTEM_DATABASE_URL=postgresql://calculation_worker:replace-me@postgres:5432/calculations
# Required only by `calculation-worker worker`; keep stable across replacement replicas.
DBOS_EXECUTOR_ID=worker-a
DBOS_APPLICATION_VERSION=v1
DBOS_SYSTEM_SCHEMA=dbos
DBOS_WORKER_CONCURRENCY=4
DBOS_MAX_RECOVERY_ATTEMPTS=3
DBOS_SHUTDOWN_GRACE_SECONDS=30

UPSTREAM_API_BASE_URL=http://upstream:8080
UPSTREAM_API_PATH_TEMPLATE=/calculations/{calc_id}
UPSTREAM_API_TOKEN=replace-me
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5.0
UPSTREAM_READ_TIMEOUT_SECONDS=30.0
UPSTREAM_WRITE_TIMEOUT_SECONDS=10.0
UPSTREAM_POOL_TIMEOUT_SECONDS=5.0
UPSTREAM_MAX_CONNECTIONS=20
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=10
METRICS_PORT=8000
