# Local Compose demo only. Replace these secrets before deployment.
POSTGRES_PASSWORD=local_demo_database_password
WRITER_API_TOKEN=local-demo-token-change-before-deploy-1234567890
WRITER_POOL_SIZE=4
WRITER_MAX_UPLOAD_BYTES=5368709120
WRITER_MAX_LINE_BYTES=1048576
WRITER_UPLOAD_TIMEOUT_SECONDS=3600
WRITER_EXPORT_TIMEOUT_SECONDS=3600
WRITER_READ_TIMEOUT_SECONDS=30
WRITER_ACQUIRE_TIMEOUT_SECONDS=5
WRITER_DB_COMMAND_TIMEOUT_SECONDS=60
# For a local process, export a DSN for your own PostgreSQL explicitly.
# WRITER_DATABASE_URL=postgresql://writer:password@localhost:5432/stream_writer
